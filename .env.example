# AIRouter Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://airouter:airouter_pass@localhost:5432/airouter

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=dev-secret-change-in-production-f8a9b3c2d1e0
JWT_EXPIRY=7d

# API Key Configuration
API_KEY_PREFIX=sk-air

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# External Provider API Keys (Optional - for Week 3-4)
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# MISTRAL_API_KEY=your-mistral-api-key-here

# Billing & Credits
DEFAULT_ORG_CREDITS=100000

# CORS Configuration
CORS_ORIGIN=*

# Monitoring (Optional)
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001
